# ============ Supabase ============
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Chi dung o server (Route Handler / Server Action) - KHONG bao gio expose ra client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ============ App ============
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============ VNPay (sandbox) ============
# Lay tu https://sandbox.vnpayment.vn (merchant test).
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL VNPay redirect ve sau khi thanh toan (khop route handler).
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/return
